# ---------- Shared / deployment ----------
PUBLIC_APP_URL=/app
APP_URL=http://localhost:8080

# ---------- Veylo app / self-hosted LiveKit ----------
# Local development only. Production must be a browser-reachable wss:// URL.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
NEXT_PUBLIC_BASE_PATH=/app

# Optional in local development. Production preflight requires >=32 characters.
VEYLO_INVITE_SECRET=

# ---------- OpenRouter: server-side only ----------
OPENROUTER_API_KEY=
STT_MODEL=openai/whisper-large-v3-turbo
TRANSLATION_MODEL=google/gemini-3.1-flash-lite
# Prioritize short response time for conversational translation.
OPENROUTER_PROVIDER_SORT=latency
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=eve
# Optional model+voice pair. Leave blank unless the pair has been verified.
TTS_FALLBACK_MODEL=
TTS_FALLBACK_VOICE=
