# ---------- Shared / deployment ----------
PUBLIC_APP_URL=/app

# ---------- Veylo app / self-hosted LiveKit ----------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
NEXT_PUBLIC_BASE_PATH=/app

# ---------- OpenRouter: server-side only ----------
OPENROUTER_API_KEY=
STT_MODEL=openai/whisper-large-v3
TRANSLATION_MODEL=google/gemini-3.1-flash-lite
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=eve
TTS_FALLBACK_MODEL=mistralai/voxtral-mini-tts-2603
TTS_FALLBACK_VOICE=en_paul_neutral
