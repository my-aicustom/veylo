{
  "name": "veylo",
  "version": "0.4.0",
  "private": true,
  "description": "Veylo internal multilingual communication: Astro marketing site + self-hosted LiveKit application + OpenRouter interpretation.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.18.2",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "concurrently -n site,app -c cyan,magenta \"pnpm --filter @veylo/site dev\" \"pnpm --filter @veylo/app dev\"",
    "dev:site": "pnpm --filter @veylo/site dev",
    "dev:app": "pnpm --filter @veylo/app dev",
    "build": "pnpm --filter @veylo/site build && pnpm --filter @veylo/app build",
    "build:site": "pnpm --filter @veylo/site build",
    "build:app": "pnpm --filter @veylo/app build",
    "typecheck": "pnpm --filter @veylo/app typecheck",
    "audit:static": "node scripts/project-audit.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
