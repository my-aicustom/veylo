# Copy to .env.production and replace every placeholder.
PUBLIC_APP_URL=/app
APP_URL=https://veylo.example.com

LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me-with-a-long-random-secret
NEXT_PUBLIC_BASE_PATH=/app

OPENROUTER_API_KEY=replace-me
STT_MODEL=openai/whisper-large-v3-turbo
TRANSLATION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_PROVIDER_SORT=latency
TTS_MODEL=x-ai/grok-voice-tts-1.0
TTS_VOICE=eve
TTS_FALLBACK_MODEL=
TTS_FALLBACK_VOICE=
