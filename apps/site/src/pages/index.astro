---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL || '/app';
const modes = [
  { no: '01', title: 'Live Call', text: 'Start a private video room. Each participant can hear the conversation in the language that works for them.', tag: 'REMOTE' },
  { no: '02', title: 'Face-to-Face', text: 'Place one device between two people and let Veylo handle the language turn by turn.', tag: 'IN PERSON' },
  { no: '03', title: 'AI Simulation', text: 'Practice a buyer meeting, negotiation, interview, or pitch with an AI counterpart from another country.', tag: 'PRACTICE' }
];
---
<BaseLayout>
  <div class="site-shell">
    <header class="topbar">
      <Logo />
      <nav aria-label="Primary navigation">
        <a href="#product">Product</a>
        <a href="#modes">Modes</a>
        <a href="#how">How it works</a>
        <a href="#principles">Principles</a>
      </nav>
      <a class="top-cta" href={appUrl}>Open Veylo <ArrowIcon /></a>
    </header>

    <main>
      <section class="hero" id="product">
        <div class="hero-kicker reveal"><span class="pulse-dot"></span> INTERNAL BETA · MULTILINGUAL COMMUNICATION</div>
        <h1 class="reveal">Say it once.<br/><em>Be understood</em> anywhere.</h1>
        <div class="hero-lower reveal">
          <p>Veylo is a live conversation layer for people who do not share a language. Video calls, in-person meetings, and realistic practice—without turning the conversation into a control panel.</p>
          <div class="hero-actions">
            <a class="button button-solid" href={appUrl}>Start a conversation <ArrowIcon /></a>
            <a class="text-link" href="#how">See how it works</a>
          </div>
        </div>

        <div class="conversation-frame reveal" aria-label="Example translated conversation">
          <div class="frame-head">
            <div><span class="status-live"></span> LIVE CONVERSATION</div>
            <div class="frame-meta">ID → FR · 00:07:18</div>
          </div>
          <div class="people-grid">
            <article class="person person-a">
              <div class="avatar">HA</div>
              <div><strong>Heri</strong><span>Indonesia · Bahasa Indonesia</span></div>
              <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            </article>
            <div class="interpretation-line" aria-hidden="true"><span></span><b>interpreting</b><span></span></div>
            <article class="person person-b">
              <div class="avatar">CL</div>
              <div><strong>Claire</strong><span>France · Français</span></div>
              <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            </article>
          </div>
          <div class="caption-stack">
            <p class="original">“Kami bisa menyiapkan sampel produknya minggu ini.”</p>
            <p class="translated">« Nous pouvons préparer les échantillons cette semaine. »</p>
          </div>
          <div class="frame-foot">
            <span>Names, numbers and business terms stay in context.</span>
            <span>AI mediator <b>off</b></span>
          </div>
        </div>
      </section>

      <section class="statement reveal">
        <p>Not another meeting platform with a translation button.</p>
        <h2>The conversation is the product.</h2>
      </section>

      <section class="modes" id="modes">
        <div class="section-intro reveal">
          <span class="section-label">THREE WAYS TO TALK</span>
          <h2>One language layer.<br/>Different situations.</h2>
        </div>
        <div class="mode-list">
          {modes.map((mode) => (
            <article class="mode-row reveal">
              <div class="mode-no">{mode.no}</div>
              <div class="mode-copy"><span>{mode.tag}</span><h3>{mode.title}</h3><p>{mode.text}</p></div>
              <div class="mode-arrow"><ArrowIcon /></div>
            </article>
          ))}
        </div>
      </section>

      <section class="how" id="how">
        <div class="section-intro reveal">
          <span class="section-label">HOW IT WORKS</span>
          <h2>Less setup.<br/>More conversation.</h2>
        </div>
        <div class="steps">
          <article class="step reveal"><span>1</span><h3>Tell us who you are.</h3><p>Name and country. No account, password, or onboarding maze.</p></article>
          <article class="step reveal"><span>2</span><h3>Start or join.</h3><p>Share a room link or QR. Camera, microphone, and language context follow the participant.</p></article>
          <article class="step reveal"><span>3</span><h3>Talk normally.</h3><p>Veylo detects spoken language, interprets for the listener, and keeps the original conversation intact for a post-meeting brief.</p></article>
        </div>
      </section>

      <section class="principles" id="principles">
        <div class="principles-head reveal">
          <span class="section-label">PRODUCT PRINCIPLES</span>
          <h2>AI should disappear into the conversation.</h2>
        </div>
        <div class="principle-grid">
          <article class="reveal"><h3>Communication first</h3><p>Our call infrastructure is self-hosted. Veylo owns the room experience instead of sitting on top of Zoom or Meet.</p></article>
          <article class="reveal"><h3>Country is context, not a stereotype</h3><p>Country helps suggest likely languages. Live speech detection decides what is actually being spoken.</p></article>
          <article class="reveal"><h3>Translation stays translation</h3><p>The interpreter does not silently rewrite intent. Clarification is shown separately as AI mediator output.</p></article>
          <article class="reveal"><h3>Built for real details</h3><p>Names, quantities, currencies, dates, product terms, and trade vocabulary are treated as high-priority context.</p></article>
          <article class="reveal"><h3>Leave with the meeting, not just a transcript</h3><p>Generate a factual brief with parties, products, commercial terms, commitments, action items, follow-ups, and open questions.</p></article>
        </div>
      </section>

      <section class="architecture reveal">
        <span class="section-label">UNDER THE HOOD</span>
        <div class="architecture-grid">
          <h2>Your call.<br/>Our infrastructure.<br/><em>AI where it helps.</em></h2>
          <div class="stack">
            <div><span>01</span><strong>Astro</strong><p>Fast public-facing site with minimal client JavaScript.</p></div>
            <div><span>02</span><strong>LiveKit, self-hosted</strong><p>Realtime audio and video communication on infrastructure we control.</p></div>
            <div><span>03</span><strong>OpenRouter</strong><p>External AI inference for speech, translation, conversation and voice output.</p></div>
          </div>
        </div>
      </section>

      <section class="final-cta reveal">
        <span class="section-label">READY WHEN YOU ARE</span>
        <h2>Start with a name.<br/>End with understanding.</h2>
        <a class="button button-solid button-large" href={appUrl}>Open Veylo <ArrowIcon /></a>
      </section>
    </main>

    <footer class="footer">
      <Logo />
      <p>Working codename for an internal MY-AI product.</p>
      <div><span>© 2026 MY-AI</span><a href="#product">Back to top ↑</a></div>
    </footer>
  </div>

  <style is:global>
    :root{--paper:#f2f0eb;--ink:#121516;--muted:#6b6d6b;--line:#d2d0ca;--accent:#ee5a39;--soft:#e9e6de;--white:#fff;--radius:1.05rem;--max:1440px}
    *{box-sizing:border-box}
    html{scroll-behavior:smooth;background:var(--paper);color:var(--ink)}
    body{margin:0;background:var(--paper);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);font-synthesis:none;-webkit-font-smoothing:antialiased}
    ::selection{background:var(--ink);color:var(--paper)}
    a,button{color:inherit}
    .site-shell{min-height:100svh;overflow:hidden}
    .topbar{height:84px;max-width:var(--max);margin:auto;padding:0 clamp(1.25rem,4vw,4.5rem);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;border-bottom:1px solid var(--line)}
    .topbar nav{display:flex;gap:1.65rem;font-size:.78rem;font-weight:650}
    .topbar nav a,.text-link{position:relative;text-decoration:none}
    .topbar nav a:after,.text-link:after{content:"";position:absolute;left:0;right:100%;bottom:-.28rem;height:1px;background:currentColor;transition:right .28s ease}
    .topbar nav a:hover:after,.text-link:hover:after{right:0}
    .top-cta{justify-self:end;display:inline-flex;gap:.45rem;align-items:center;text-decoration:none;font-size:.78rem;font-weight:750}
    .hero{max-width:var(--max);margin:auto;padding:clamp(4.5rem,9vw,9rem) clamp(1.25rem,4vw,4.5rem) 0}
    .hero-kicker,.section-label{font-size:.69rem;font-weight:760;letter-spacing:.13em;color:var(--muted)}
    .pulse-dot,.status-live{display:inline-block;width:.5rem;height:.5rem;border-radius:50%;background:var(--accent);margin-right:.5rem;vertical-align:.02rem}
    .pulse-dot{animation:pulse 2.2s ease-out infinite}
    @keyframes pulse{0%,45%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 40%,transparent)}70%,100%{box-shadow:0 0 0 10px transparent}}
    .hero h1{font-size:clamp(4rem,9.5vw,9rem);line-height:.86;letter-spacing:-.078em;margin:2rem 0 2.8rem;max-width:1250px;font-weight:760}
    .hero h1 em,.architecture h2 em{font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:-.06em}
    .hero-lower{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.55fr);gap:clamp(2rem,8vw,9rem);align-items:end;border-top:1px solid var(--line);padding-top:1.6rem}
    .hero-lower>p{font-size:clamp(1.05rem,1.6vw,1.45rem);line-height:1.52;max-width:760px;margin:0}
    .hero-actions{display:flex;align-items:center;justify-content:flex-end;gap:1.4rem}
    .button{border:1px solid var(--ink);border-radius:999px;display:inline-flex;align-items:center;justify-content:center;gap:.6rem;padding:.9rem 1.2rem;text-decoration:none;font-size:.82rem;font-weight:760;transition:transform .2s ease,background .2s ease,color .2s ease}
    .button:hover{transform:translateY(-2px)}
    .button-solid{background:var(--ink);color:var(--paper)}
    .button-solid:hover{background:var(--accent);border-color:var(--accent);color:#fff}
    .text-link{font-size:.8rem;font-weight:690}
    .conversation-frame{margin-top:clamp(4rem,7vw,7rem);background:var(--ink);color:var(--paper);border-radius:1.35rem 1.35rem 0 0;min-height:520px;padding:1.15rem 1.15rem 1.3rem;box-shadow:0 35px 90px rgba(21,25,23,.12)}
    .frame-head,.frame-foot{display:flex;justify-content:space-between;align-items:center;font-size:.65rem;letter-spacing:.075em;text-transform:uppercase;color:#aaa9a4;padding:.35rem .35rem 1.2rem}
    .frame-head>div:first-child{color:#f3f1ec}.frame-meta{font-variant-numeric:tabular-nums}
    .people-grid{display:grid;grid-template-columns:1fr minmax(130px,.28fr) 1fr;gap:1rem;min-height:295px}
    .person{background:#1a1e1f;border:1px solid #292d2e;border-radius:.95rem;padding:1.3rem;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden}
    .person:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(238,90,57,.14),transparent 38%);opacity:.8}
    .person-b:before{background:radial-gradient(circle at 18% 18%,rgba(120,144,255,.14),transparent 38%)}
    .avatar{width:3.2rem;height:3.2rem;border-radius:50%;display:grid;place-items:center;border:1px solid #424647;margin-bottom:auto;font-size:.76rem;color:#c9cbc7}
    .person strong{display:block;font-size:1.15rem;margin-bottom:.28rem;position:relative}.person span{color:#929593;font-size:.75rem;position:relative}
    .signal{position:absolute;right:1.2rem;bottom:1.3rem;display:flex;align-items:end;gap:3px;height:20px}.signal i{display:block;width:2px;background:var(--accent);border-radius:2px;animation:signal 1.1s ease-in-out infinite}.signal i:nth-child(1){height:5px}.signal i:nth-child(2){height:13px;animation-delay:.1s}.signal i:nth-child(3){height:20px;animation-delay:.2s}.signal i:nth-child(4){height:10px;animation-delay:.3s}.signal i:nth-child(5){height:16px;animation-delay:.4s}
    @keyframes signal{50%{transform:scaleY(.42);opacity:.55}}
    .interpretation-line{display:flex;align-items:center;gap:.6rem;color:#767977;font-size:.6rem;text-transform:uppercase;letter-spacing:.08em}.interpretation-line span{height:1px;flex:1;background:#35393a}.interpretation-line b{font-weight:600}
    .caption-stack{padding:1.5rem 1.15rem .9rem;max-width:1000px;margin:auto;text-align:center}.caption-stack p{margin:0}.original{font-size:.8rem;color:#8c908e;margin-bottom:.6rem!important}.translated{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.35rem,2.3vw,2.2rem);line-height:1.25}
    .frame-foot{border-top:1px solid #2c3031;padding-top:1rem;padding-bottom:0;text-transform:none;letter-spacing:0}.frame-foot b{color:#ef8b75;font-weight:650}
    .statement{max-width:var(--max);padding:clamp(7rem,12vw,12rem) clamp(1.25rem,4vw,4.5rem);margin:auto;display:grid;grid-template-columns:.7fr 2fr;gap:4rem;border-bottom:1px solid var(--line)}
    .statement p{font-size:.78rem;color:var(--muted);margin:.6rem 0}.statement h2{font-size:clamp(3rem,6.7vw,7rem);letter-spacing:-.07em;line-height:.92;margin:0;font-weight:720}
    .modes,.how,.principles,.architecture,.final-cta{max-width:var(--max);margin:auto;padding:clamp(6rem,10vw,10rem) clamp(1.25rem,4vw,4.5rem);border-bottom:1px solid var(--line)}
    .section-intro{display:grid;grid-template-columns:.7fr 2fr;gap:4rem;margin-bottom:4rem}.section-intro h2,.principles-head h2{font-size:clamp(2.7rem,5.4vw,5.8rem);line-height:.95;letter-spacing:-.065em;margin:0;font-weight:690}
    .mode-row{display:grid;grid-template-columns:.5fr 2fr auto;align-items:center;gap:2rem;padding:2.1rem 0;border-top:1px solid var(--line);transition:padding .25s ease}.mode-row:last-child{border-bottom:1px solid var(--line)}.mode-row:hover{padding-left:.8rem;padding-right:.8rem}.mode-no{font-variant-numeric:tabular-nums;color:var(--muted);font-size:.72rem}.mode-copy span{font-size:.63rem;color:var(--muted);letter-spacing:.11em}.mode-copy h3{font-size:clamp(2rem,3vw,3.4rem);letter-spacing:-.05em;margin:.2rem 0 .5rem}.mode-copy p{max-width:650px;color:var(--muted);line-height:1.5;margin:0}.mode-arrow{width:3rem;height:3rem;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;transition:background .2s ease,color .2s ease,transform .2s ease}.mode-row:hover .mode-arrow{background:var(--ink);color:var(--paper);transform:rotate(-12deg)}
    .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}.step{background:var(--paper);padding:2rem;min-height:280px;display:flex;flex-direction:column}.step>span{font-size:.7rem;color:var(--muted);margin-bottom:auto}.step h3{font-size:1.8rem;letter-spacing:-.04em;margin:2rem 0 .8rem}.step p{line-height:1.55;color:var(--muted);margin:0}
    .principles{display:grid;grid-template-columns:.86fr 1.4fr;gap:clamp(3rem,9vw,10rem)}.principles-head h2{margin-top:1.2rem}.principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:3rem 2rem}.principle-grid article{border-top:1px solid var(--line);padding-top:1.2rem}.principle-grid h3{font-size:1.16rem;letter-spacing:-.025em;margin:0 0 .8rem}.principle-grid p{line-height:1.55;color:var(--muted);margin:0;font-size:.9rem}
    .architecture{background:var(--ink);color:var(--paper);max-width:none;padding-left:max(clamp(1.25rem,4vw,4.5rem),calc((100vw - var(--max))/2 + 4.5rem));padding-right:max(clamp(1.25rem,4vw,4.5rem),calc((100vw - var(--max))/2 + 4.5rem))}.architecture .section-label{color:#858a87}.architecture-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(4rem,10vw,12rem);margin-top:2rem}.architecture h2{font-size:clamp(3.1rem,5.8vw,6rem);line-height:.93;letter-spacing:-.065em;margin:0}.stack>div{display:grid;grid-template-columns:36px 1fr;column-gap:1rem;border-top:1px solid #303435;padding:1.35rem 0}.stack span{grid-row:1/3;color:#6f7471;font-size:.68rem}.stack strong{font-size:1rem}.stack p{color:#999d9a;margin:.3rem 0 0;line-height:1.45;font-size:.84rem}
    .final-cta{text-align:center;padding-top:clamp(8rem,13vw,13rem);padding-bottom:clamp(8rem,13vw,13rem)}.final-cta h2{font-size:clamp(3.2rem,7.3vw,7.5rem);line-height:.9;letter-spacing:-.073em;margin:1.4rem auto 3rem;max-width:1150px}.button-large{padding:1.15rem 1.55rem;font-size:.9rem}
    .footer{max-width:var(--max);margin:auto;padding:2.4rem clamp(1.25rem,4vw,4.5rem) 3.5rem;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:end;gap:2rem;font-size:.7rem;color:var(--muted)}.footer p{margin:0;text-align:center}.footer>div{display:flex;justify-content:flex-end;gap:1.2rem}.footer a{text-decoration:none}
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .75s cubic-bezier(.2,.75,.2,1),transform .75s cubic-bezier(.2,.75,.2,1)}.reveal.is-visible{opacity:1;transform:none}
    @media(max-width:960px){.topbar{grid-template-columns:1fr auto}.topbar nav{display:none}.hero-lower,.statement,.section-intro,.principles,.architecture-grid{grid-template-columns:1fr}.hero-lower{gap:2rem}.hero-actions{justify-content:flex-start}.statement,.section-intro{gap:1.2rem}.people-grid{grid-template-columns:1fr 80px 1fr}.principles{gap:4rem}.footer{grid-template-columns:1fr auto}.footer p{display:none}}
    @media(max-width:720px){.topbar{height:70px}.top-cta{font-size:0;gap:0}.top-cta svg{display:block}.hero{padding-top:4rem}.hero h1{font-size:clamp(3.5rem,17vw,6.1rem);margin-top:1.4rem}.hero-lower>p{font-size:1rem}.hero-actions{align-items:flex-start;flex-direction:column}.conversation-frame{min-height:520px;padding:.75rem}.frame-head{font-size:.55rem}.people-grid{grid-template-columns:1fr 1fr;min-height:240px}.interpretation-line{display:none}.person{padding:.9rem}.person span{font-size:.64rem}.signal{display:none}.frame-foot span:first-child{max-width:70%}.statement,.modes,.how,.principles,.final-cta{padding-top:6rem;padding-bottom:6rem}.statement h2{font-size:3.45rem}.mode-row{grid-template-columns:34px 1fr auto;gap:1rem}.mode-copy p{font-size:.85rem}.steps,.principle-grid{grid-template-columns:1fr}.step{min-height:220px}.principle-grid{gap:2rem}.architecture{padding-top:6rem;padding-bottom:6rem}.architecture-grid{gap:4rem}.footer{grid-template-columns:1fr 1fr}.footer>div span{display:none}}
    @media(max-width:440px){.people-grid{grid-template-columns:1fr}.person-b{display:none}.conversation-frame{min-height:480px}.translated{font-size:1.35rem}.frame-foot{font-size:.56rem}.mode-arrow{width:2.4rem;height:2.4rem}.mode-copy h3{font-size:1.85rem}.final-cta h2{font-size:3.25rem}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.pulse-dot,.signal i{animation:none}.reveal{opacity:1;transform:none;transition:none}.button,.mode-row,.mode-arrow{transition:none}}
  </style>

  <script>
    const boot = () => {
      const items = document.querySelectorAll('.reveal:not([data-reveal-ready])');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { items.forEach((el) => el.classList.add('is-visible')); return; }
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach((el) => { el.setAttribute('data-reveal-ready','true'); observer.observe(el); });
    };
    document.addEventListener('astro:page-load', boot);
    boot();
  </script>
</BaseLayout>
