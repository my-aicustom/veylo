---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL || 'https://veylo.163.61.44.41.sslip.io/app';
const modes = [
  { no: '01', title: 'Live Call (Video Negotiation)', text: 'Meet overseas buyers with live bilingual subtitles, voice interpretation, and an interactive trade canvas beside your conversation.', tag: 'ACROSS BORDERS' },
  { no: '02', title: 'Face-to-Face Negotiation', text: 'One tablet or laptop on the table. Give exporter and buyer a shared understanding of every specification, price, and commitment.', tag: 'ACROSS THE TABLE' },
  { no: '03', title: 'AI Simulation (Trade Rehearsal)', text: 'Rehearse with international AI buyer personas. Negotiate unit prices, defend your margins, and practice L/C or T/T payment terms.', tag: 'BEFORE THE DEAL' }
];
const pillars = [
  { no: '01', tag: 'CLASSIFY / CALCULATE', title: 'Automated Tariff & HS Code Finder', text: 'Move from commodity descriptions to HS code suggestions and duty estimates. Explore ATIGA, IEU-CEPA, and RCEP scenarios with origin and destination in context.' },
  { no: '02', tag: 'CHECK / PREPARE', title: 'Regulatory & Compliance Radar', text: 'Surface export permits, BPOM, agricultural quarantine, phytosanitary certificates, COO / SKA, and destination quality requirements before shipment.' },
  { no: '03', tag: 'REHEARSE / NEGOTIATE', title: 'Bilingual Buyer Negotiation Simulation', text: 'Practice with AI buyer personas from different markets. Work through price objections and commercial terms in both languages before your real meeting.' },
  { no: '04', tag: 'CONNECT / SYNC', title: 'Omnichannel WhatsApp & Live Canvas Sync', text: 'Bring buyer messages from WhatsApp into the meeting. n8n webhooks dispatch real-time SSE events to switch the shared canvas as the conversation evolves.' }
];
---
<BaseLayout title="Veylo — Global trade, in conversation." description="An omnichannel global trade operations platform. Bilingual meetings, AI trade intelligence, export documents, and WhatsApp canvas sync in one workspace.">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="site-shell">
    <header class="topbar">
      <Logo />
      <nav aria-label="Primary navigation">
        <a href="#product">Product</a>
        <a href="#trade-ai">Trade AI</a>
        <a href="#documents">Documents</a>
        <a href="#modes">Modes</a>
        <a href="#architecture">Architecture</a>
      </nav>
      <a class="top-cta" href={appUrl}>Open Veylo <ArrowIcon /></a>
    </header>

    <main id="main-content">
      <section class="hero" id="product">
        <div class="hero-kicker"><span class="pulse-dot"></span> AI-POWERED GLOBAL TRADE OPERATIONS &amp; REAL-TIME INTERPRETATION</div>
        <h1 class="reveal">Talk naturally.<br/>Close deals globally.<br/><em>Veylo handles the rest.</em></h1>
        <div class="hero-lower">
          <p>From the first conversation to the final shipment. Bring bilingual video interpretation, HS code and tariff intelligence, and instant export document generation into one shared workspace.</p>
          <div class="hero-actions">
            <a class="button button-solid" href={appUrl}>Open your workspace <ArrowIcon /></a>
            <a class="text-link" href="#trade-ai">Explore the suite</a>
          </div>
        </div>

        <div class="conversation-frame" aria-label="Interactive demonstration of a bilingual trade meeting">
          <div class="frame-head">
            <div><span class="status-live"></span> TRADE ROOM / LIVE PREVIEW</div>
            <div class="frame-meta">JAKARTA ↔ PARIS · ID / FR</div>
          </div>
          <div class="workspace-grid"><div class="meeting-preview"><div class="people-grid">
            <article class="person person-a">
              <div class="avatar">HA</div>
              <div><strong>Heri</strong><span>Indonesia · Bahasa Indonesia</span></div>
              <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            </article>
            <div class="interpretation-line" aria-hidden="true"><span></span><b>interpreting</b><span></span></div>
            <article class="person person-b">
              <div class="avatar">CL</div>
              <div><strong>Claire</strong><span>France · Français</span></div>
              <div class="signal" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
            </article>
          </div>
          <div class="caption-stack">
            <p class="original"><span lang="id">“Harga FOB untuk 5.000 kg kopi adalah $24.500.”</span></p>
            <p class="translated"><span lang="fr">« Le prix FOB pour 5 000 kg de café est de 24 500 $. »</span></p>
          </div>
          </div><aside class="trade-panel" aria-label="Illustrative trade intelligence">
            <span class="section-label">TRADE INTELLIGENCE / 01</span>
            <h3>The details.<br/><em>Already in context.</em></h3>
            <dl><div><dt>Green coffee · HS code</dt><dd>0901.11</dd></div><div><dt>ASEAN–EU · illustrative tariff</dt><dd>0% <small>scenario</small></dd></div></dl>
            <div class="fob-demo">
              <label for="coffee-quantity">FOB calculator · quantity (kg)</label>
              <input id="coffee-quantity" type="number" min="1" max="1000000" step="1" value="5000" inputmode="numeric" />
              <span>Unit price · USD 4.90 / kg</span>
              <output id="fob-total" for="coffee-quantity" aria-live="polite">$24,500</output>
            </div>
            <p class="demo-note">Illustrative data. Verify classification, current tariffs, and origin eligibility before shipment.</p>
          </aside></div>
          <div class="frame-foot">
            <span>One conversation. A shared commercial context.</span>
            <span>WhatsApp → n8n → canvas <b>sync</b></span>
          </div>
        </div>
      </section>

      <section class="statement">
        <p>THE LANGUAGE OF<br/>YOUR NEXT OPPORTUNITY.</p>
        <h2>From “hello”<br/>to <em>ready to ship.</em></h2>
      </section>

      <section class="trade-suite" id="trade-ai">
        <div class="section-intro"><span class="section-label">01 / AI TRADE INTELLIGENCE SUITE</span><h2>Know the market.<br/><em>Move with clarity.</em></h2></div>
        <div class="intelligence-grid">{pillars.map((pillar) => (
          <article><div class="pillar-meta"><span>{pillar.no}</span><span>{pillar.tag}</span></div><h3>{pillar.title}</h3><p>{pillar.text}</p></article>
        ))}</div>
      </section>

      <section class="documents" id="documents">
        <div class="section-intro"><span class="section-label">02 / 1-CLICK EXPORT DOCUMENTS</span><h2>A deal, documented.<br/><em>Down to the detail.</em></h2></div>
        <div class="document-intro"><p>Turn agreed terms into commercial paperwork in standard export formats. Calculate FOB in real time, review the details, and download a crisp vector PDF.</p><a class="button button-solid" href={appUrl}>Export to Vector PDF <ArrowIcon /></a></div>
        <div class="document-grid">
          <article class="document-sheet"><div class="sheet-top"><b>VEYLO / TRADE</b><span>01 — COMMERCIAL</span></div><h3>Commercial<br/>Invoice</h3><p class="document-id">INV / 2026 / 0042 · SAMPLE</p><dl><div><dt>Incoterms</dt><dd>FOB · Jakarta</dd></div><div><dt>Commodity</dt><dd>Green coffee beans</dd></div><div><dt>Quantity × unit price</dt><dd>5,000 kg × $4.90</dd></div><div><dt>Currency</dt><dd>USD</dd></div></dl><div class="sheet-total"><span>FOB TOTAL</span><strong>$24,500.00</strong></div><p>Invoice numbers, incoterms, FOB calculation, and currency breakdown in one document.</p></article>
          <article class="document-sheet"><div class="sheet-top"><b>VEYLO / LOGISTICS</b><span>02 — SHIPMENT</span></div><h3>Packing<br/>List</h3><p class="document-id">PKL / 2026 / 0042 · SAMPLE</p><dl><div><dt>Packages</dt><dd>100 bags</dd></div><div><dt>Net weight</dt><dd>5,000 kg</dd></div><div><dt>Gross weight</dt><dd>5,100 kg</dd></div><div><dt>Container · internal</dt><dd>5.90 × 2.35 × 2.39 m</dd></div></dl><div class="sheet-total"><span>CONTAINER</span><strong>20′ dry</strong></div><p>Package counts, net and gross weights, and container dimensions, ready for handover.</p></article>
          <article class="document-sheet origin-sheet"><div class="sheet-top"><b>ASEAN / ORIGIN</b><span>03 — PREFERENCE</span></div><h3>Certificate<br/>of Origin</h3><p class="document-id">SKA / FORM D · SAMPLE DRAFT</p><dl><div><dt>Exporter</dt><dd>Indonesia</dd></div><div><dt>Destination</dt><dd>Malaysia</dd></div><div><dt>Framework</dt><dd>ATIGA</dd></div><div><dt>Origin criterion</dt><dd>Pending verification</dd></div></dl><div class="sheet-total"><span>PREFERENTIAL TRADE</span><strong>Form D</strong></div><p>Prepare a preferential-origin draft for eligible intra-ASEAN trade. Official issuance requires the competent authority.</p></article>
        </div>
        <p class="document-note">Illustrative documents. Invoice and packing list show the coffee shipment; Form D shows a separate intra-ASEAN route.</p>
      </section>

      <section class="modes" id="modes">
        <div class="section-intro">
          <span class="section-label">03 / THREE WAYS TO TRADE</span>
          <h2>Across oceans.<br/><em>Across the table.</em></h2>
        </div>
        <div class="mode-list">
          {modes.map((mode) => (
            <article class="mode-row">
              <div class="mode-no">{mode.no}</div>
              <div class="mode-copy"><span>{mode.tag}</span><h3>{mode.title}</h3><p>{mode.text}</p></div>
              <div class="mode-arrow"><ArrowIcon /></div>
            </article>
          ))}
        </div>
      </section>

      <section class="architecture" id="architecture">
        <span class="section-label">04 / UNDER THE HOOD</span>
        <div class="architecture-grid">
          <h2>One workspace.<br/>Connected systems.<br/><em>Built to move.</em></h2>
          <div class="stack">
            <div><span>01</span><strong>Astro 5</strong><p>Pre-rendered static pages, fast delivery, and no client framework runtime. Just the interactions you need.</p></div>
            <div><span>02</span><strong>OpenRouter AI Engine</strong><p>Multi-model intelligence for trade inference and translation, connected to the voice STT / TTS pipeline.</p></div>
            <div><span>03</span><strong>LiveKit Infrastructure</strong><p>Low-latency WebRTC audio and video on self-hosted infrastructure, with bilingual conversations at the center.</p></div>
            <div><span>04</span><strong>n8n Webhook Automation</strong><p>A VPS workflow orchestrator connects WhatsApp to event dispatch and real-time canvas updates over SSE.</p></div>
          </div>
        </div>
      </section>

      <section class="final-cta">
        <span class="section-label">READY WHEN YOU ARE</span>
        <h2>Your next market<br/>starts with <em>a conversation.</em></h2>
        <a class="button button-solid button-large" href={appUrl}>Open Veylo <ArrowIcon /></a>
      </section>
    </main>

    <footer class="footer">
      <Logo />
      <p>Global trade, in conversation.</p>
      <div><span>© 2026 MY-AI</span><a href="#product">Back to top ↑</a></div>
    </footer>
  </div>

  <style is:global>
    :root{--paper:#f2f0eb;--ink:#121516;--muted:#6b6d6b;--line:#d2d0ca;--accent:#ee5a39;--max:1440px}
    *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--paper);color:var(--ink)}body{margin:0;font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}::selection{background:var(--ink);color:var(--paper)}
    :where(a,button,input):focus-visible{outline:3px solid var(--accent);outline-offset:5px}a{min-height:44px;display:inline-flex;align-items:center}section{scroll-margin-top:24px}em{font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:-.055em}p{line-height:1.6}h1,h2,h3,p{overflow-wrap:break-word}svg{flex-shrink:0}.skip-link{position:fixed;top:12px;left:12px;background:var(--ink);color:white;padding:12px;z-index:10;transform:translateY(-200%)}.skip-link:focus{transform:none}
    .topbar,main>section,.footer{max-width:var(--max);margin:auto;padding-inline:clamp(1.25rem,4vw,4.5rem)}.topbar{display:flex;justify-content:space-between;align-items:center;gap:28px;min-height:88px;border-bottom:1px solid var(--line)}.topbar nav{display:flex;gap:24px}.topbar a{text-decoration:none;font-size:12px;font-weight:650}.topbar nav a:hover,.text-link:hover{color:#ae371e}.top-cta{gap:8px;white-space:nowrap}.hero{padding-top:90px}.hero-kicker,.section-label{font-size:10px;font-weight:700;letter-spacing:.12em;line-height:1.6;color:var(--muted)}.pulse-dot,.status-live{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);margin-right:8px}.hero h1{font-size:clamp(3rem,7.9vw,7.6rem);line-height:1.01;letter-spacing:-.07em;font-weight:650;margin:28px 0 40px}.hero h1 em{letter-spacing:-.065em}.hero-lower{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;border-top:1px solid var(--line);padding-top:24px;align-items:center}.hero-lower p{font-size:18px;max-width:660px;margin:0}.hero-actions{display:flex;justify-content:flex-end;align-items:center;flex-wrap:wrap;gap:12px 24px}.button{gap:12px;padding:16px 22px;border:1px solid var(--ink);text-decoration:none;font-size:12px;font-weight:650;transition:background .2s,color .2s}.button-solid{background:var(--ink);color:var(--paper)}.button:hover{background:#343936}.text-link{font-size:12px;text-underline-offset:5px}
    .conversation-frame{margin-top:64px;background:var(--ink);color:var(--paper);padding:22px}.frame-head,.frame-foot{display:flex;justify-content:space-between;gap:16px;font-size:10px;letter-spacing:.06em;color:#b5b9b5;line-height:1.6}.frame-head{padding-bottom:22px}.frame-foot{padding-top:18px;border-top:1px solid #3d4240;margin-top:22px;letter-spacing:0}.frame-foot b{color:#f6967f}.workspace-grid{display:grid;grid-template-columns:1.8fr 1fr;gap:24px}.meeting-preview{min-width:0;display:flex;flex-direction:column}.people-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;flex:1;min-height:230px}.person{background:#242b2b;padding:24px;display:flex;flex-direction:column;position:relative;border-top:2px solid #8eaaa5;min-width:0}.person-a{border-color:var(--accent);background:#2d302b}.avatar{width:60px;height:60px;border:1px solid #717b73;border-radius:50%;display:grid;place-items:center;font-family:Georgia,serif;font-size:22px;margin-bottom:65px}.person strong,.person span{display:block}.person strong{font-size:19px;margin-bottom:6px}.person span{font-size:11px;color:#bec5c0}.interpretation-line{display:none}.signal{position:absolute;top:28px;right:20px;display:flex;gap:3px;align-items:center;height:20px}.signal i{width:2px;height:8px;background:#f6967f}.signal i:nth-child(2n){height:19px}.signal i:nth-child(3){height:13px}.caption-stack{text-align:center;padding:30px 14px 8px}.original{color:#b5b9b5;font-size:12px;margin:0 0 12px}.translated{font-family:Georgia,serif;font-size:24px;line-height:1.3;margin:0}.trade-panel{border-left:1px solid #3d4240;padding-left:24px}.trade-panel .section-label{color:#b5b9b5}.trade-panel h3{font-size:28px;line-height:1.1;letter-spacing:-.04em;margin:20px 0}.trade-panel dl{margin:0}.trade-panel dl>div{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid #3d4240;padding:12px 0}.trade-panel dt{font-size:11px;color:#b5b9b5}.trade-panel dd{font-size:23px;margin:0;white-space:nowrap}.trade-panel small{font-size:10px;color:#b5b9b5}.fob-demo{border-top:1px solid #3d4240;padding-top:16px;display:grid;grid-template-columns:1fr 90px;gap:10px;align-items:center}.fob-demo label,.fob-demo span{font-size:11px;color:#b5b9b5}.fob-demo input{width:100%;min-height:44px;background:#262d2b;color:white;border:1px solid #748079;padding:8px;font:inherit;font-size:13px}.fob-demo output{grid-column:1/-1;font-size:36px;letter-spacing:-.04em}.demo-note{font-size:10px;color:#b5b9b5;margin-bottom:0;max-width:340px}
    .statement{display:grid;grid-template-columns:1fr 2fr;gap:48px;padding-block:110px;border-bottom:1px solid var(--line)}.statement p{font-size:10px;letter-spacing:.12em;color:var(--muted)}.statement h2{font-size:clamp(3rem,6.8vw,6.5rem);line-height:1;letter-spacing:-.065em;font-weight:600;margin:0}.trade-suite,.documents,.modes,.architecture,.final-cta{padding-block:100px;border-bottom:1px solid var(--line)}.section-intro{display:grid;grid-template-columns:1fr 2fr;gap:48px;margin-bottom:56px}.section-intro h2,.architecture h2{font-size:clamp(2.7rem,5vw,5rem);line-height:1.02;letter-spacing:-.06em;font-weight:600;margin:0}.intelligence-grid{display:grid;grid-template-columns:1fr 1fr;column-gap:64px;row-gap:40px}.intelligence-grid article{border-top:1px solid var(--line);padding-top:20px}.pillar-meta{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.1em;color:var(--muted)}.intelligence-grid h3{font-size:28px;font-weight:550;letter-spacing:-.035em;max-width:420px;margin:32px 0 16px}.intelligence-grid p{font-size:14px;color:var(--muted);max-width:510px;margin:0}.documents{background:#e9e6de}.document-intro{display:flex;align-items:center;justify-content:space-between;gap:32px;margin-bottom:40px}.document-intro p{max-width:670px;font-size:15px;margin:0}.document-intro .button{flex-shrink:0}.document-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.document-sheet{background:#faf9f5;padding:26px 22px;border-top:3px solid var(--ink)}.sheet-top{display:flex;justify-content:space-between;gap:8px;font-size:8px;letter-spacing:.06em}.sheet-top span{color:var(--muted)}.document-sheet h3{font-family:Georgia,serif;font-size:36px;line-height:1.05;font-weight:400;letter-spacing:-.04em;margin:36px 0 18px}.document-id{font-size:9px;letter-spacing:.06em;border-bottom:1px solid var(--ink);padding-bottom:18px}.document-sheet dl>div{padding:10px 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:12px;font-size:10px}.document-sheet dd{margin:0;text-align:right}.document-sheet dt{color:var(--muted)}.sheet-total{margin-top:22px;padding-block:20px;border-block:1px solid var(--ink);display:flex;justify-content:space-between;align-items:center;gap:12px}.sheet-total span{font-size:8px;letter-spacing:.08em}.sheet-total strong{font-size:23px;letter-spacing:-.04em}.document-sheet>p:last-child{font-size:11px;color:var(--muted);margin-bottom:0}.origin-sheet{border-top-color:var(--accent)}.document-note{font-size:11px;color:#565854;margin-top:24px}
    .mode-row{display:grid;grid-template-columns:1fr 5fr auto;gap:24px;border-top:1px solid var(--line);padding:30px 0}.mode-no,.mode-copy span{font-size:10px;letter-spacing:.1em;color:var(--muted)}.mode-copy h3{font-size:clamp(1.6rem,3vw,3rem);letter-spacing:-.05em;font-weight:550;margin:10px 0}.mode-copy p{font-size:14px;color:var(--muted);max-width:680px;margin:0}.mode-arrow{align-self:center}.architecture{background:var(--ink);color:var(--paper)}.architecture .section-label{color:#b5b9b5}.architecture-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;margin-top:40px}.stack>div{display:grid;grid-template-columns:30px 1fr;border-top:1px solid #3d4240;padding:20px 0;gap:8px}.stack span{grid-row:1/3;font-size:10px;color:#b5b9b5}.stack strong{font-size:16px;font-weight:550}.stack p{color:#b5b9b5;font-size:13px;margin:0}.final-cta{text-align:center;padding-block:120px}.final-cta h2{font-size:clamp(3rem,6vw,6rem);line-height:1.05;letter-spacing:-.06em;font-weight:600;margin:28px 0 40px}.footer{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:28px}.footer p,.footer>div{font-size:11px;color:var(--muted)}.footer>div{display:flex;gap:24px;align-items:center}.footer a{text-underline-offset:4px}
    @starting-style{.hero h1{opacity:0;transform:translateY(12px)}}.hero h1{transition:opacity .7s,transform .7s}
    @media(min-width:1600px){.hero{padding-top:110px}}
    @media(max-width:1000px){.topbar{flex-wrap:wrap;gap:4px 20px;padding-top:14px}.topbar nav{order:3;width:100%;justify-content:space-between;gap:12px}.hero{padding-top:64px}.hero-lower{gap:28px;grid-template-columns:1.3fr 1fr}.workspace-grid{grid-template-columns:1.4fr 1fr}.person{padding:16px}.signal{right:12px}.document-grid{gap:12px}.document-sheet{padding:20px 14px}.sheet-top{flex-direction:column}.document-sheet h3{font-size:30px}.document-sheet dl>div{flex-direction:column;gap:5px}.document-sheet dd{text-align:left}.sheet-total{align-items:flex-start;flex-direction:column}.architecture-grid{gap:36px}}
    @media(max-width:700px){.hero{padding-top:48px}.hero-kicker{max-width:310px;font-size:9px}.hero h1{font-size:clamp(2.5rem,8.8vw,3.85rem);margin-bottom:28px}.hero-lower,.workspace-grid,.section-intro,.statement,.architecture-grid{grid-template-columns:1fr;gap:24px}.hero-lower p{font-size:16px}.hero-actions{justify-content:flex-start}.conversation-frame{margin-top:40px;padding:16px}.frame-head,.frame-foot{flex-wrap:wrap;font-size:9px}.people-grid{min-height:190px}.avatar{width:44px;height:44px;font-size:16px;margin-bottom:40px}.person span{font-size:10px;max-width:120px}.signal{display:none}.translated{font-size:22px}.trade-panel{border-left:0;border-top:1px solid #3d4240;padding:24px 0 0}.trade-panel h3 br{display:none}.trade-panel h3 em{margin-left:5px}.trade-panel h3{font-size:27px}.fob-demo{grid-template-columns:1fr 110px}.statement,.trade-suite,.documents,.modes,.architecture{padding-block:64px}.section-intro{margin-bottom:36px}.intelligence-grid{grid-template-columns:1fr;gap:32px}.intelligence-grid h3{font-size:26px;margin-top:24px}.document-intro{align-items:flex-start;flex-direction:column;gap:20px}.document-grid{grid-template-columns:1fr;gap:24px}.document-sheet{padding:28px}.sheet-top{flex-direction:row}.document-sheet h3{font-size:38px}.document-sheet dl>div{flex-direction:row}.document-sheet dd{text-align:right}.sheet-total{flex-direction:row;align-items:center}.mode-row{grid-template-columns:24px 1fr;gap:14px}.mode-arrow{display:none}.final-cta{padding-block:80px}.footer{align-items:flex-start;flex-wrap:wrap}.footer>div{width:100%;justify-content:space-between}.footer p{max-width:130px;margin:0}.topbar nav a{font-size:11px}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}}
  </style>

  <script>
    const quantity = document.querySelector<HTMLInputElement>('#coffee-quantity');
    const total = document.querySelector<HTMLOutputElement>('#fob-total');
    quantity?.addEventListener('input', () => {
      if (!total) return;
      total.value = quantity.validity.valid && quantity.value !== ''
        ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(quantity.valueAsNumber * 4.9)
        : 'Enter 1–1,000,000 kg';
    });
  </script>
</BaseLayout>
